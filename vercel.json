{
  "installCommand": "npm install",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:match*",
      "destination": "https://kayal-dental-tourism-treatment.onrender.com/api/:match*"
    },
    {
      "source": "/uploads/:match*",
      "destination": "https://kayal-dental-tourism-treatment.onrender.com/uploads/:match*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}